{
  "name": "dalux-build-api",
  "version": "2.4.0",
  "description": "Node.js client for the Dalux Build API",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "require": "./dist/browser.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "require": "./dist/next.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "jest --coverage",
    "pack:check": "npm run build && npm pack --dry-run",
    "release:check": "npm run typecheck && npm test && npm run pack:check"
  },
  "keywords": [
    "dalux",
    "build",
    "api",
    "client",
    "construction"
  ],
  "author": "Bruno Adam",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bruadam/dalux-build.git",
    "directory": "javascript"
  },
  "bugs": {
    "url": "https://github.com/bruadam/dalux-build/issues"
  },
  "homepage": "https://github.com/bruadam/dalux-build/tree/main/javascript#readme",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "axios-mock-adapter": "^2.1.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.2.5",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  },
  "jest": {
    "testEnvironment": "node",
    "preset": "ts-jest",
    "testMatch": [
      "**/test/**/*.test.ts"
    ]
  }
}
