{
  "name": "dalux-build-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server exposing read-only Dalux Build API access (and document search) as tools",
  "main": "dist/index.js",
  "bin": {
    "dalux-mcp": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build:app": "node scripts/build-ifc-viewer.mjs && node scripts/build-task-timeline.mjs",
    "prebuild": "npm run build:app",
    "predev": "npm run build:app",
    "pretest": "npm run build:app",
    "pretypecheck": "npm run build:app",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "dev": "tsx src/cli.ts",
    "docs:build": "tsx scripts/build-docs-index.ts",
    "test": "node scripts/run-jest.mjs --coverage"
  },
  "license": "MIT",
  "dependencies": {
    "@ifc-lite/clash": "^2.2.1",
    "@ifc-lite/geometry": "^7.1.0",
    "@ifc-lite/mcp": "^0.16.0",
    "@ifc-lite/parser": "^6.5.0",
    "@ifc-lite/query": "^2.4.0",
    "@ifc-lite/sdk": "^6.1.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@napi-rs/canvas": "^1.0.9",
    "dalux-build-api": "*",
    "fflate": "^0.8.3",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "5.4.296",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@ifc-lite/embed-sdk": "^1.15.0",
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/core": "^2.0.0",
    "@modelcontextprotocol/ext-apps": "^2.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "jest": "^30.5.1",
    "ts-jest": "^29.2.5",
    "tsup": "^8.3.5",
    "tsx": "^4.23.13",
    "typescript": "^5.7.2"
  },
  "jest": {
    "testEnvironment": "node",
    "preset": "ts-jest",
    "testMatch": [
      "**/test/**/*.test.ts"
    ]
  }
}
