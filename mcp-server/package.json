{
  "name": "dalux-build-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server exposing read-only Dalux Build API access (and document search) as tools",
  "main": "dist/index.js",
  "bin": {
    "dalux-mcp": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "skills"
  ],
  "scripts": {
    "build:app": "node scripts/build-ifc-viewer.mjs && node scripts/build-task-timeline.mjs && node scripts/build-skills.mjs",
    "prebuild": "npm run build:app",
    "predev": "npm run build:app",
    "pretest": "npm run build:app",
    "pretypecheck": "npm run build:app",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "dev": "tsx src/cli.ts",
    "docs:build": "tsx scripts/build-docs-index.ts",
    "test": "node scripts/run-jest.mjs --coverage",
    "test:platform": "node scripts/run-jest.mjs --runInBand --testPathIgnorePatterns /node_modules/ --testMatch '**/test/platform/**/*.test.ts'"
  },
  "license": "MIT",
  "dependencies": {
    "@cantoo/pdf-lib": "^2.11.1",
    "@dalux-platform/db": "*",
    "@ifc-lite/clash": "^2.4.4",
    "@ifc-lite/geometry": "^7.1.0",
    "@ifc-lite/mcp": "^0.23.0",
    "@ifc-lite/parser": "^9.8.0",
    "@ifc-lite/query": "^2.4.0",
    "@ifc-lite/sdk": "^9.6.0",
    "@mistralai/mistralai": "^2.7.0",
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.0.0",
    "@napi-rs/canvas": "^0.1.80",
    "dalux-build-api": "*",
    "drizzle-orm": "^0.45.4",
    "fflate": "^0.8.3",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "5.4.296",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/core": "^2.0.0",
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "esbuild": "^0.28.2",
    "jest": "^30.5.2",
    "three": "^0.187.0",
    "ts-jest": "^29.4.14",
    "tsup": "^8.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2"
  },
  "jest": {
    "testEnvironment": "node",
    "preset": "ts-jest",
    "testMatch": [
      "**/test/**/*.test.ts"
    ],
    "setupFiles": [
      "<rootDir>/test/setupNapiCanvas.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/test/platform/"
    ]
  }
}
