# One origin: the MCP server under /mcp, its OAuth discovery, registration,
# token and revocation endpoints, and the web interface for everything else
# (including the OAuth /authorize consent page).
#
# X-Forwarded-For is overwritten with the address Caddy saw, so a client cannot
# spoof the IP that the platform logs (TRUSTED_PROXY_HOPS=1 trusts exactly this hop).
# The MCP server's /metrics listens on its own port (METRICS_PORT) that is not routed here.
{$PLATFORM_SITE_ADDRESS:localhost} {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	@mcp path /mcp /mcp/* /.well-known/* /token /register /revoke
	handle @mcp {
		reverse_proxy mcp:8080 {
			header_up X-Forwarded-For {remote_host}
		}
	}
	handle {
		# Next.js needs inline scripts and styles; nothing is loaded from other origins.
		header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
		reverse_proxy web:3000 {
			header_up X-Forwarded-For {remote_host}
		}
	}
}
