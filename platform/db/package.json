{
  "name": "@dalux-platform/db",
  "version": "0.1.0",
  "private": true,
  "description": "Postgres schema, migrations, row-level security, and secret helpers for the self-hosted Dalux MCP platform",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "dalux-platform-migrate": "dist/migrate-cli.js"
  },
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "generate": "drizzle-kit generate",
    "migrate": "tsx src/migrate-cli.ts",
    "test": "jest --runInBand"
  },
  "license": "MIT",
  "dependencies": {
    "cron-parser": "^5.10.2",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.14",
    "tsup": "^8.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2"
  },
  "jest": {
    "testEnvironment": "node",
    "preset": "ts-jest",
    "testMatch": [
      "**/test/**/*.test.ts"
    ],
    "testTimeout": 30000
  }
}
