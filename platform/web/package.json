{
  "name": "@dalux-platform/web",
  "version": "0.1.0",
  "private": true,
  "description": "Admin and account interface for the self-hosted Dalux MCP platform",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "@dalux-platform/db": "*",
    "@node-rs/argon2": "^2.2.2",
    "@phosphor-icons/react": "^2.1.10",
    "better-auth": "^1.7.18",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dalux-build-api": "*",
    "drizzle-orm": "^0.45.4",
    "next": "^16.4.5",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.23.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/test/**/*.test.ts"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    },
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": {
            "module": "commonjs",
            "moduleResolution": "node",
            "jsx": "react-jsx",
            "esModuleInterop": true,
            "isolatedModules": true
          }
        }
      ]
    },
    "testTimeout": 30000
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jest": "^30.5.2",
    "tailwindcss": "^4.3.5",
    "ts-jest": "^29.4.15",
    "typescript": "^5.9.3"
  }
}
