# Generated automatically by:
# docker compose --profile setup run --rm setup
# Save both values in a password manager. Never rotate MONITOR_MASTER_KEY while
# the SQLite database contains jobs encrypted with it.
MONITOR_API_TOKEN=replace-with-generated-management-token
MONITOR_MASTER_KEY=replace-with-generated-fernet-key

# Used when a registration omits daluxBaseUrl. The Dalux API key is always
# supplied per job and encrypted in SQLite.
DALUX_BASE_URL=https://<your-company>.dalux.com/api

MONITOR_TIMEZONE=UTC
STATE_DB_PATH=./state.sqlite3
WEBHOOK_MAX_ATTEMPTS=8
HOST=0.0.0.0
PORT=8000
